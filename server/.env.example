# ---------------------------------------------------------------
# Copy this file to server/.env and fill in your values.
# Every entry is optional — development defaults apply when unset.
# ---------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Use Supabase as the hosted Postgres:
# Supabase Studio -> Project Settings -> Database -> Connection string.
# The "Session pooler" URI is safest for servers and migrations:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct connection also works where IPv6 is available:
#   DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Notes:
#  - URL-encode special characters in the password (e.g. @ -> %40).
#  - TLS is enabled automatically for Supabase hosts; force with DB_SSL=true.
#  - First start applies migrations + base seed automatically (`npm run db:push`
#    does the same without booting the API). Demo data: `npm run seed:demo`.
#
# DATABASE_URL=postgresql://postgres.projectref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Local embedded Postgres instead (npm run db:start): leave DATABASE_URL unset.
# DATABASE_URL=postgres://postgres:depot_dev_password@127.0.0.1:5433/depot

# DB_SSL=true|false   # force TLS on/off regardless of the URL

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Bootstrap Super Admin — created only when the users table is empty.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=Admin@2026
BOOTSTRAP_ADMIN_NAME=System Administrator
